{% assign repo_url = include.repository | split: '/' %}
{% assign data_key = 'github_repo_' | append: repo_url[0] | append: '_' | append: repo_url[1] %}
{% assign repo_data = site.data[data_key] %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}">
    {% if repo_data %}
      <div class="repo-card">
        <div class="repo-card-header">
          <i class="fa-solid fa-book-bookmark"></i>
          <span class="repo-card-name">{{ repo_data.name }}</span>
        </div>
        {% if repo_data.description %}
          <p class="repo-card-description">{{ repo_data.description }}</p>
        {% endif %}
        <div class="repo-card-stats">
          {% if repo_data.language %}
            <span class="repo-card-language">
              <span class="repo-card-language-dot"></span>
              {{ repo_data.language }}
            </span>
          {% endif %}
          <span class="repo-card-stat"> <i class="fa-regular fa-star"></i> {{ repo_data.stargazers_count | default: 0 }} </span>
          <span class="repo-card-stat"> <i class="fa-solid fa-code-fork"></i> {{ repo_data.forks_count | default: 0 }} </span>
        </div>
      </div>
    {% else %}
      <div class="repo-card">
        <div class="repo-card-header">
          <i class="fa-solid fa-book-bookmark"></i>
          <span class="repo-card-name">{{ include.repository }}</span>
        </div>
      </div>
    {% endif %}
  </a>
</div>
